<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define"
         xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">

    <j:set var="containerId" value="quay-param-${it.name}"/>
    <f:entry title="${it.name}" description="${it.description}">
        <div name="parameter" id="${containerId}"
             data-quay-endpoint="${it.quayEndpoint}"
             data-organization="${it.organization}"
             data-credentials-id="${it.credentialsId}"
             data-tag-limit="${it.tagLimit}"
             data-default-tag="${it.defaultTag}"
             data-fetch-url="${rootURL}/descriptorByName/io.jenkins.plugins.quay.QuayImageParameterDefinition/fetchTagsJson">
            <input type="hidden" name="name" value="${it.name}"/>

            <div class="jenkins-!-margin-bottom-1">
                <label class="jenkins-!-text-color-secondary">Repository</label>
                <input type="text" class="jenkins-input quay-repo-input"
                       name="repository" value="${it.repository}"/>
            </div>

            <j:set var="tagList" value="${it.availableTags}"/>
            <j:set var="currentDefault" value="${it.defaultTag}"/>
            <div class="jenkins-select">
                <select class="jenkins-select__input quay-tag-select" name="value">
                    <j:choose>
                        <j:when test="${!empty(tagList)}">
                            <j:forEach var="tag" items="${tagList}">
                              <f:option selected="${tag.name eq currentDefault}" value="${tag.name}">${tag.name}</f:option>
                            </j:forEach>
                        </j:when>
                        <j:otherwise>
                            <option value="">-- No tags available --</option>
                        </j:otherwise>
                    </j:choose>
                </select>
            </div>
            <div class="jenkins-!-margin-top-1 jenkins-!-text-color-secondary quay-status">
                <strong>Image: </strong>
                <span class="quay-image-ref" style="font-family: monospace;">
                    ${it.quayEndpoint}/${it.organization}/${it.repository}
                </span>
            </div>
        </div>

        <st:adjunct includes="io.jenkins.plugins.quay.QuayImageParameterDefinition.reactive"/>
        <script type="text/javascript">
            (function() {
                var el = document.getElementById('${containerId}');
                if (el &amp;&amp; window.QuayReactiveParameter) {
                    window.QuayReactiveParameter.init(el);
                }
            })();
        </script>
    </f:entry>
</j:jelly>
